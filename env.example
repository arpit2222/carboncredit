# VeChain Carbon Credit NFT System - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# VeChain Private Keys (without 0x prefix)
# Get testnet VET/VTHO from: https://faucet.vechain.org
PRIVATE_KEY_TESTNET=your_testnet_private_key_here
PRIVATE_KEY_MAINNET=your_mainnet_private_key_here

# IPFS Configuration (for future metadata uploads)
# Get API keys from: https://pinata.cloud or https://web3.storage
IPFS_API_KEY=your_ipfs_api_key_here

# Network Configuration
VECHAIN_NETWORK=testnet

# Security Warning:
# - Never share your private keys
# - Use testnet keys for development
# - Keep mainnet keys secure and offline when possible
# - Consider using hardware wallets for production
